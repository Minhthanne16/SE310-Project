# Sao chép thành .env; không commit file .env. Docker Compose tự đọc file này.
# Khi chạy "dotnet run" trực tiếp, .env không được tự nạp: đặt các biến tương ứng
# (ConnectionStrings__DefaultConnection, Authentication__Jwt__SigningKey, ...) trong terminal.

# Bắt buộc cho cả compose.yaml và compose.neon.yaml. Để trống để Compose/API dừng an toàn.
# Tạo giá trị ngẫu nhiên >= 32 byte, ví dụ: openssl rand -base64 48
JWT_SIGNING_KEY=

# Chỉ dùng với PostgreSQL local: docker compose up --build
POSTGRES_USER=se310
POSTGRES_PASSWORD=
POSTGRES_DB=se310
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Chỉ dùng với Neon: docker compose -f compose.neon.yaml up --build
# Lấy chuỗi POOLED (-pooler) của đúng branch/database/role từ Neon Console.
# Migration, pg_dump và pg_restore phải dùng chuỗi DIRECT (không có -pooler) trong terminal riêng,
# không thay giá trị POOLED bên dưới.
ConnectionStrings__DefaultConnection=

# Tùy chọn: chỉ cần nếu đăng nhập Google được bật.
GOOGLE_CLIENT_ID=

# Compose local để trống toàn bộ SMTP_* để dùng Mailpit (http://localhost:8025).
# Khi chạy Neon, cần cấu hình SMTP thật để người dùng nhận OTP. Gmail dùng App Password,
# không dùng mật khẩu Gmail: smtp.gmail.com:587, STARTTLS=true.
SMTP_HOST=
SMTP_PORT=
SMTP_USE_STARTTLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
